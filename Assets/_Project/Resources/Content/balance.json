  // Plantas (GDD 10.6): caem em PEDACOS, e completar uma e objetivo de longo prazo.
  // A chance e por corrida; o alvo sai do pool do tier da corrida, com peso INVERSO ao
  // dropWeight - a planta serve para cortar a cauda do RNG, entao ela aponta justamente
  // para a peca que raramente cai. blueprintFragmentsPerBlueprint e o "/5" da secao 10.6.
  "blueprintFragmentChance": 0.30,
  "blueprintFragmentsPerBlueprint": 5,
  // Rivais (GDD 13.1). O encontro so e sorteado no tier do rival, entao a chance por
  // corrida e a chance de ver AQUELE rival - nao a de ver "um rival qualquer".
  // rivalDefeatsForCarBlueprint e o "tres vezes" literal da secao 13.1.
  "rivalEncounterChance": 0.08,
  "rivalDefeatsForCarBlueprint": 3,
  "rivalDefeatFragments": 2,

