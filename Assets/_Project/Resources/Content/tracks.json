// Escala da secao 5.1: 18-30 segmentos, ~1,2-2,0 km.
//
// baseTimeSeconds e o tempo de referencia do grid de adversarios (GDD 5.6), e nao um
// adversario real a bater - os seis carros sao amostrados de N(t_ref, t_ref * 0.06).
// Calibrado para o teste "carro inicial na pista inicial vence 55-75%" (GDD 21.2).
{
  "tracks": [
    {
      // 0-2 min da primeira hora: uma corrida, um carro, sem menu (GDD 22.3).
      "id": "city_loop",
      "name": "Centro - Volta Curta",
