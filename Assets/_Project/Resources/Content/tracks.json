      "tier": "D",
      "baseTimeSeconds": 73,
      "scoreMultiplier": 1.00,
      "baseCash": 200,
      "baseXp": 40,
      "reputationRequired": 0,
      "modules": [
        "str_med", "gentle_l", "str_med", "gentle_r",
